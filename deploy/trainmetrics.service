[Unit]
Description=TrainMetrics
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/trainmetrics/backend
# Holds the Polar credentials and the address of the laptop that runs Ollama.
EnvironmentFile=/home/pi/trainmetrics/backend/.env
ExecStart=/home/pi/trainmetrics/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
